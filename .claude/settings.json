{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/validate_notebook_json.py",
            "statusMessage": "Validating notebook JSON..."
          }
        ]
      }
    ]
  }
}
